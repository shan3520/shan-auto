# Copy to .env and fill in. .env is gitignored.

# Contribution verification (doctor + the daily report) prefers the `gh` CLI:
# run `gh auth login` once and leave both of these blank. The credential then
# lives in the OS keyring instead of a file in this repo.
#
# Only needed on a machine without `gh`. Classic token, scope: read:user.
GH_TOKEN=

# Optional. Verification uses whichever account the credential belongs to; set
# this only to be warned when that is not the account you expected.
GH_USER=

# Optional: free phone push notifications via https://ntfy.sh
# Pick any hard-to-guess topic string, subscribe to it in the ntfy app.
# The topic is PUBLIC unless you add a token below. Without one, only the
# notification title is ever sent — never failure details or commit text.
NTFY_TOPIC=
# Optional but strongly recommended: an access token for the topic (ntfy app >
# Settings > Access tokens). This makes the topic private and unlocks sending
# the full message body.
NTFY_TOKEN=
